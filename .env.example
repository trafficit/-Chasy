# ---------------------------------------------------------------------------
# Copy to .env and fill in.   cp .env.example .env
# ---------------------------------------------------------------------------

# Domain Caddy serves + gets a TLS cert for. Use ":80" for a local test.
SITE_ADDRESS=worklog.example.com

# Public URL of the app - MUST match how users open it (used in magic links).
BASE_URL=https://worklog.example.com

# Secrets - generate: openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Session + magic link lifetime
SESSION_DAYS=30
MAGIC_LINK_TTL_MINUTES=20

# ---------------------------------------------------------------------------
# SMTP for the login e-mails. Any provider works (your mail server, Brevo,
# Mailgun, Amazon SES, Yandex 360, Gmail app-password, ...).
# Leave SMTP_HOST empty to run without e-mail: the login link is printed to
# `docker compose logs -f app` instead (fine for first tests).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WorkLog <no-reply@example.com>
SMTP_STARTTLS=true

# Also print the magic link to the log even when SMTP is configured.
DEV_ECHO_MAGIC_LINK=false
