# ---------------------------------------------------------------------------
# Copy to .env and fill in.   cp .env.example .env
# ---------------------------------------------------------------------------

# Public URL of the app - MUST match how users open it (used in magic links).
BASE_URL=https://chasy.profitsenser.com

# Local port the app is published on (127.0.0.1 only). The reverse proxy
# forwards here — see deploy/chasy.caddy.
APP_PORT=8813

# Secrets
SECRET_KEY=replace-with-openssl-rand-hex-32          # openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password # openssl rand -hex 24

# Session + magic link lifetime
SESSION_DAYS=30
MAGIC_LINK_TTL_MINUTES=20

# ---------------------------------------------------------------------------
# SMTP for the login e-mails.
# NOTE: many VPS providers block outbound ports 25/465/587. If yours does,
# use a transactional provider on port 2525 (Brevo / Mailgun / SendGrid all
# support it): SMTP_PORT=2525, SMTP_STARTTLS=true.
# Gmail (smtp.gmail.com) only offers 25/465/587 — won't work behind such a
# block. Leave SMTP_HOST empty to run without e-mail (link printed to
# `docker compose logs -f app`).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Chasy <no-reply@example.com>
SMTP_STARTTLS=true

# Also print the magic link to the log even when SMTP is configured.
DEV_ECHO_MAGIC_LINK=false

# Anti-abuse for the sign-in form (magic-link spam / e-mail bombing).
# Defaults are sane; tune only if legitimate users hit limits.
AUTH_MIN_INTERVAL_SEC=45
AUTH_MAX_LIVE_TOKENS=3
AUTH_MAX_PER_MIN_PER_IP=5
AUTH_MAX_PER_HOUR_PER_IP=20

# ---------------------------------------------------------------------------
# Licensing (model A: access codes with an expiry date).
#   LICENSE_REQUIRED=false -> the app is free for everyone (default).
#   LICENSE_REQUIRED=true  -> every user must redeem an access code; when it
#                            expires the app becomes read-only (data is kept,
#                            export still works) until the code is renewed.
#   TRIAL_DAYS=N           -> new accounts get N days free before a code is
#                            needed (0 = no trial).
#   ADMIN_TOKEN            -> unlocks the /admin panel where you create and
#                            renew codes. Empty = admin panel disabled.
#                            Generate: openssl rand -hex 24
# ---------------------------------------------------------------------------
LICENSE_REQUIRED=false
TRIAL_DAYS=0
# /admin login. ADMIN_USER is optional (empty = only the token is asked).
ADMIN_USER=trafficit365@gmail.com
ADMIN_TOKEN=

# E-mail domains that are always free — no code, no expiry banner.
# Comma-separated, e.g. FREE_EMAIL_DOMAINS=ges-rent.sk,partner.example
FREE_EMAIL_DOMAINS=

# Promo codes that always work: seeded on start as never-expiring,
# unlimited-seat licenses. Comma-separated, e.g. PROMO_CODES=MayDay2027
PROMO_CODES=

# Bump when frontend/terms.html changes — stored per user on acceptance.
TOS_VERSION=2026-09-09

# ---------------------------------------------------------------------------
# Pricing + proforma invoices (/invoice page, shown in "About").
# "Create invoice" appears once SELLER_NAME + (SELLER_IBAN or SELLER_PAY_LINK)
# are set. Use SELLER_PAY_LINK (a Wise "request money" / payment link) and
# leave SELLER_IBAN empty to keep the IBAN off the invoice entirely.
# ---------------------------------------------------------------------------
INVOICE_PRICE=7
INVOICE_CURRENCY=EUR
INVOICE_DUE_DAYS=7
INVOICE_NUMBER_PREFIX=PF
SELLER_NAME=
SELLER_ADDRESS=
SELLER_REG_ID=
SELLER_IBAN=
SELLER_BANK=
SELLER_PAY_LINK=
SELLER_EMAIL=
# printed on every invoice (the app is for non-VAT sellers)
INVOICE_NOTE=Nie sme platcami DPH. / Не является плательщиком НДС.
